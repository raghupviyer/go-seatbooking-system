DATABASE_URL=postgres://postgres:postgres@postgres:5432/ticketbooking?sslmode=disable
APP_PORT=8080
# how long a "held" reservation stays valid before seats are re-reservable
validation_timeout=15m
# bcrypt cost for password hashing
salt_rounds=10
# secret used to sign JWTs (access token expires in 15m) - change this
jwt_secret=change-me
